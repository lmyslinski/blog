---
import { type CollectionEntry, getCollection } from "astro:content";
import CoreLayout from "@/layouts/CoreLayout.astro";
import Prose from "@/components/markdown/Prose.astro";
import { Image, Picture } from "astro:assets";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await post.render();
---

<CoreLayout {...post.data}>
  {
    post.data.heroImage && (
      <div class="pt-10 pb-12 flex justify-center">
        <Image
          src={post.data.heroImage}
          alt={post.data.title}
          class="rounded-md"
          width={post.data.heroImageWidth}
          height={post.data.heroImageHeight}
          style={{
            objectFit: "contain",
            maxHeight: "400px",
            maxWidth: "100%",
            width: "auto",
            height: "auto",
          }}
        />
      </div>
    )
  }
  <Prose>
    <Content />
  </Prose>
</CoreLayout>
